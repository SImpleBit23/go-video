{
  "id": "st-govideo-d",
  "kind": "tool",
  "version": "0.1.5",
  "license": "GPL-3.0-or-later",
  "title": "Go Video service",
  "description": "Изолированный VK-каталог и плеер Go Video, на основе RideTube.",
  "requires": {
    "mgu-deploy": "0.7.0",
    "mgu-python": "1.0.2",
    "jap-node22": "22.23.4",
    "mgu-render": "0.6.11"
  },
  "uninstallable": true,
  "internet": true,
  "uids": "state/internet-uids",
  "mguHmi": [
    "ID7"
  ],
  "files": [
    {
      "path": "ytd.js",
      "from": "ytd.js",
      "mode": "0644"
    },
    {
      "path": "health.js",
      "from": "health.js",
      "mode": "0644"
    },
    {
      "path": "remote.js",
      "from": "remote.js",
      "mode": "0644"
    },
    {
      "path": "remote.html",
      "from": "remote.html",
      "mode": "0644"
    },
    {
      "path": "remote-strings.json",
      "from": "remote-strings.json",
      "mode": "0644"
    },
    {
      "path": "ytdec",
      "from": "build/ytdec",
      "mode": "0755"
    },
    {
      "path": "ytfetch.py",
      "from": "ytfetch.py",
      "mode": "0644"
    },
    {
      "path": "ytdlp.pyz",
      "from": "build/ytdlp.pyz",
      "mode": "0644"
    },
    {
      "path": "oapgen.js",
      "from": "../../kit/tools/oapgen/gen.js",
      "mode": "0644"
    },
    {
      "path": "thumb.js",
      "from": "thumb.js",
      "mode": "0644"
    },
    {
      "path": "vendor/jpeg-js/decoder.js",
      "from": "vendor/jpeg-js/decoder.js",
      "mode": "0644"
    },
    {
      "path": "vendor/jpeg-js/LICENSE",
      "from": "vendor/jpeg-js/LICENSE",
      "mode": "0644"
    },
    {
      "path": "check.sh",
      "from": "check.sh",
      "mode": "0755"
    },
    {
      "path": "LICENSE",
      "from": "../../LICENSE",
      "mode": "0644"
    },
    {
      "path": "THIRD_PARTY_LICENSES",
      "from": "../../THIRD_PARTY_LICENSES",
      "mode": "0644"
    },
    {
      "path": "vk.js",
      "from": "vk.js",
      "mode": "0644"
    },
    {
      "path": "vkfetch.py",
      "from": "vkfetch.py",
      "mode": "0644"
    },
    {
      "path": "ffmpeg",
      "from": "build/ffmpeg",
      "mode": "0755"
    },
    {
      "path": "ffmpeg-source.tar.xz",
      "from": "build/ffmpeg-source.tar.xz",
      "mode": "0644"
    },
    {
      "path": "FFMPEG_LICENSE.txt",
      "from": "build/FFMPEG_LICENSE.txt",
      "mode": "0644"
    },
    {
      "path": "oauth.js",
      "from": "oauth.js",
      "mode": "0644"
    },
    {
      "path": "FFMPEG_BUILD.txt",
      "from": "build/FFMPEG_BUILD.txt",
      "mode": "0644"
    },
    {
      "path": "webguest.py",
      "from": "webguest.py",
      "mode": "0644"
    }
  ],
  "check": [
    "check.sh"
  ],
  "units": [
    {
      "name": "st-govideo-d.service",
      "from": "systemd/st-govideo-d.service"
    }
  ],
  "enable": [
    {
      "unit": "st-govideo-d.service",
      "target": "multi-user.target"
    }
  ],
  "crashNames": [
    "ytdec"
  ],
  "recmgr": [
    "st-govideo-d"
  ],
  "restart": [
    "st-govideo-d.service"
  ]
}
